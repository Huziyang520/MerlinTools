{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Huziyang520/MerlinTools",
        "issues": "https://github.com/Huziyang520/MerlinTools/issues"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.huziyang520.merlintools.MerlinToolsFabric"
        ],
        "client": [
            "com.huziyang520.merlintools.client.MerlinToolsFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "icon": "mt.png",
    "custom": {
        "modmenu": {
            "links": {
                "备用反馈地址": "https://issue.mengcai.online/"
            }
        }
    }
}
